generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum BudgetType {
  OVERALL
  CATEGORY
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  CUSTOM
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  password              String

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  financialGoals        FinancialGoal[]
  goalContributions     GoalContribution[]
  settings              UserSettings?

  @@map("users")
}

model Category {
  id                    String                 @id @default(uuid())
  name                  String
  type                  CategoryType

  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([userId, name, type])
  @@map("categories")
}

model Transaction {
  id                     String                @id @default(uuid())
  amount                 Decimal               @db.Decimal(12, 2)
  type                   TransactionType
  note                   String?
  date                   DateTime

  userId                 String
  categoryId             String
  recurringTransactionId String?
  recurringOccurrenceAt  DateTime?

  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category               Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([recurringTransactionId, recurringOccurrenceAt])
  @@index([userId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@map("transactions")
}

model Budget {
  id         String       @id @default(uuid())
  amount     Decimal      @db.Decimal(12, 2)
  type       BudgetType
  period     BudgetPeriod
  startDate  DateTime
  endDate    DateTime

  userId     String
  categoryId String?

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId])
  @@index([userId, startDate, endDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@map("budgets")
}

model RecurringTransaction {
  id           String             @id @default(uuid())
  amount       Decimal            @db.Decimal(12, 2)
  type         TransactionType
  note         String?
  frequency    RecurringFrequency

  startDate    DateTime
  nextRunAt    DateTime
  endDate      DateTime?

  active       Boolean            @default(true)

  userId       String
  categoryId   String

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId])
  @@index([userId, active])
  @@index([userId, nextRunAt])
  @@index([userId, categoryId])
  @@map("recurring_transactions")
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  OVERDUE
}

enum ContributionType {
  MANUAL
  ADJUSTMENT
}

model FinancialGoal {
  id            String             @id @default(uuid())
  name          String
  description   String?

  targetAmount  Decimal            @db.Decimal(12, 2)
  currentAmount Decimal            @default(0) @db.Decimal(12, 2)

  deadline      DateTime?
  status        GoalStatus         @default(ACTIVE)

  userId        String

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, deadline])
  @@map("financial_goals")
}

model GoalContribution {
  id        String           @id @default(uuid())

  amount    Decimal          @db.Decimal(12, 2)
  note      String?
  type      ContributionType @default(MANUAL)

  goalId    String
  userId    String

  goal      FinancialGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([goalId])
  @@index([userId])
  @@index([goalId, createdAt])
  @@map("goal_contributions")
}

enum CurrencyCode {
  INR
  USD
  EUR
  GBP
  AED
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

model UserSettings {
  id                        String          @id @default(uuid())
  userId                    String          @unique
  currency                  CurrencyCode    @default(INR)
  monthlyBudgetEnabled      Boolean         @default(false)
  monthlyBudgetAmount       Decimal?        @db.Decimal(12, 2)
  budgetAlertsEnabled       Boolean         @default(true)
  recurringRemindersEnabled Boolean         @default(true)
  goalRemindersEnabled      Boolean         @default(true)
  theme                     ThemePreference @default(SYSTEM)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}



