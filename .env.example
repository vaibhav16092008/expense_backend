# ==============================================================================
# ExpenseIQ Backend — Production Environment Variables Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual secret keys, passwords, or credentials to version control.
# Copy this file to '.env' for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & NETWORK CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'test', or 'production'
NODE_ENV=development

# Server port to bind Express HTTP server
PORT=5000

# Production origin for CORS header matching.
# Specify exact frontend URL in production (e.g., https://app.expenseiq.com)
# For multiple allowed origins, separate with commas (e.g., http://localhost:3000,http://localhost:5173)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (REQUIRED)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string (URL-encoded password)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expenseiq?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify short-lived access JWT tokens.
# IN PRODUCTION: Must be set to a high-entropy string (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_strong_random_secret_in_production

# JWT access token lifetime duration (e.g., 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# JWT refresh token lifetime duration (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 4. RECURRING TRANSACTION CRON SCHEDULER (OPTIONAL)
# ------------------------------------------------------------------------------
# Enable/disable in-process automated recurring transaction processing and notification generation
CRON_RECURRING_ENABLED=true

# Cron schedule pattern (Default: Midnight daily "0 0 * * *")
CRON_RECURRING_SCHEDULE="0 0 * * *"
